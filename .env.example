# Inside docker compose the DB host is the service name `postgres`.
DATABASE_URL=postgresql://market:market@postgres:5432/market_narrative
ANTHROPIC_API_KEY=your_key_from_platform.claude.com
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_EFFORT=low

# Optional: paths to the feed list and taxonomy (defaults: config/feeds.json,
# config/taxonomy.json). Copy the *.example.json files to start.
# FEEDS_FILE=config/feeds.json
# TAXONOMY_FILE=config/taxonomy.json

# --- docker-compose.prod.yml only ---
# Use the same password in DATABASE_URL above.
# POSTGRES_PASSWORD=change-me
# Hostname pointing at the server, e.g. narratives.example.com
# SITE_ADDRESS=narratives.example.com
# DASHBOARD_USER=admin
# Bcrypt hash from: docker run --rm caddy:2.8 caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains `$`, which compose would otherwise expand.
# DASHBOARD_PASSWORD_HASH='$2a$14$...'
